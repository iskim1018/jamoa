{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jamoa",
  "version": "0.2.0",
  "identifier": "co.promptech.jamoa",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jamoa — 한글 파일명 정규화",
        "width": 620,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
